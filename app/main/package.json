{
	"name": "rquickshare",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cross-env RUST_BACKTRACE=1 VITE_VUE_DEVTOOLS=1 concurrently -k \"tauri dev\" \"pnpm devtools\"",
		"tauri": "tauri",
		"build:debug": "tauri build -d",
		"build": "tauri build",
		"vite:dev": "vite dev",
		"vite:build": "vite build",
		"test": "vitest",
		"devtools": "pnpm vue-devtools",
		"ts-check": "vue-tsc --noEmit",
		"preview": "vite preview",
		"check": "cd src-tauri && cargo check",
		"lint": "eslint .",
		"bump": "node ../../scripts/bump.mjs"
	},
	"dependencies": {
		"@martichou/core_lib": "link:../../core_lib",
