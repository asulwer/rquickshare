{
	"name": "rquickshare",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cross-env RUST_BACKTRACE=1 VITE_VUE_DEVTOOLS=1 concurrently -k \"tauri dev\" \"pnpm devtools\"",
		"tauri": "tauri",
		"build:debug": "tauri build -d",
		"build": "tauri build",
		"vite:dev": "vite dev",
		"vite:build": "vite build",
		"test": "vitest",
		"devtools": "pnpm vue-devtools",
		"ts-check": "vue-tsc --noEmit",
		"preview": "vite preview",
		"check": "cd src-tauri && cargo check",
		"lint": "eslint .",
		"build:share-extension": "bash share-extension/build.sh",
		"bump": "node ../../scripts/bump.mjs"
	},
	"dependencies": {
		"@martichou/core_lib": "link:../../core_lib",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-autostart": "^2.7.0",
		"@tauri-apps/plugin-clipboard-manager": "^2.5.0",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-notification": "^2.8.0",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"@tauri-apps/plugin-store": "^2.5.0",
		"pinia": "^4.1.0",
		"vue": "^3.5.45"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/montserrat": "5.3.0",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^24.19.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/devtools": "^8.2.1",
		"concurrently": "^10.0.7",
		"cross-env": "^10.1.0",
		"eslint": "^10.14.0",
		"eslint-plugin-vue": "^10.12.0",
		"globals": "^17.14.0",
		"tailwindcss": "^4.3.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0",
		"vue-eslint-parser": "^10.4.2",
		"vue-tsc": "^3.3.14"
	},
	"packageManager": "pnpm@12.15.0"
}
