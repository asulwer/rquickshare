{
  "identifier": "migrated",
  "description": "What the webview may call. Kept to the calls the front end makes; received files are opened through the app's own open_received / reveal_received commands, not the opener plugin.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "store:allow-get-store",
    "store:allow-get",
    "store:allow-has",
    "store:allow-set",
    "store:allow-save",
    "notification:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "dialog:allow-open",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
